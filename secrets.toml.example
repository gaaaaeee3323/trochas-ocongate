# ══════════════════════════════════════════════════════════════════════════
# PLANTILLA DE SECRETS — VialNet
#
# 1. Copia este archivo a `.streamlit/secrets.toml` (mismo nombre, sin ".example").
# 2. Rellena los valores reales con los datos de tu proyecto de Supabase.
# 3. NUNCA subas `.streamlit/secrets.toml` a GitHub — ya está excluido en .gitignore.
#
# En Streamlit Community Cloud NO subas este archivo: pega el mismo contenido
# (con tus valores reales) en Settings → Secrets del dashboard de tu app.
# ══════════════════════════════════════════════════════════════════════════

# Connection string de PostgreSQL (Supabase → Project Settings → Database →
# Connection string → modo "Session pooler" o "Direct connection").
# Reemplaza [PASSWORD] y el host por los tuyos.
SUPABASE_DB_URL = "postgresql://postgres:[PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# Supabase → Project Settings → API
SUPABASE_URL = "https://xxxxxxxxxxxx.supabase.co"

# Supabase → Project Settings → API → Project API keys → service_role
# (secreto, solo para backend — NUNCA lo uses en código que corra en el navegador)
SUPABASE_SERVICE_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....."

# Nombre del bucket de Supabase Storage donde se guardan fotos y PDFs adjuntos.
# Debe existir y estar marcado como bucket público (ver README, sección Storage).
SUPABASE_STORAGE_BUCKET = "vialnet-archivos"
